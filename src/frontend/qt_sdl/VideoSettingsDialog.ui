      <string>OpenGL renderer</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_4">
      <item row="0" column="0">
       <layout class="QHBoxLayout" name="horizontalLayoutRecommendedDefaults">
        <item>
         <widget class="QPushButton" name="btnRecommendedDefaults">
          <property name="maximumSize">
           <size>
            <width>220</width>
            <height>16777215</height>
           </size>
          </property>
          <property name="text">
           <string>Recommended Settings</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="cbAdvancedVideoSettings">
          <property name="text">
           <string>Advanced settings</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="horizontalSpacerRecommendedDefaults">
          <property name="orientation">
           <enum>Qt::Orientation::Horizontal</enum>
          </property>
          <property name="sizeHint" stdset="0">
           <size>
            <width>40</width>
            <height>20</height>
           </size>
          </property>
         </spacer>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>Resolution scale:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QCheckBox" name="cbBetterPolygons">
        <property name="whatsThis">
         <string>&lt;p&gt;Reduce distortion on quads and other complex polygons by changing how they are split for rendering. Classic OpenGL only. May reduce performance.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Improved polygon splitting</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QComboBox" name="cbxGLResolution">
        <property name="maximumSize">
         <size>
          <width>260</width>
          <height>16777215</height>
         </size>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;Higher values make 3D graphics sharper and set the output scale for screen upscaling. They use more GPU power and may expose rendering glitches. This does not change the window size. With Render 3D at native resolution enabled, 3D stays at its original resolution while the completed screen can still be upscaled.&lt;/p&gt;</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QCheckBox" name="cbReadable3DTextureCache">
        <property name="whatsThis">
         <string>&lt;p&gt;Store cached 3D textures as readable color data for inspection in tools such as RenderDoc. Classic OpenGL only. This is a debugging option, not an accuracy or image-quality improvement.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Use readable 3D texture cache (debug)</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QCheckBox" name="cbxComputeHiResCoords">
        <property name="whatsThis">
         <string>&lt;p&gt;Use subpixel positions for polygon edges when rendering above native resolution. This can make edges smoother and reduce vertex wobble. Compute only. Disable to restore the original DS-style snapping. This is separate from texture-coordinate precision.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Use high resolution coordinates</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QCheckBox" name="cbGLMSAA">
        <property name="whatsThis">
         <string>&lt;p&gt;Smooth jagged 3D polygon edges.&lt;/p&gt;&lt;p&gt;Classic OpenGL: enable multisample anti-aliasing.&lt;/p&gt;&lt;p&gt;Compute: force DS-style anti-aliasing on, even when the game disables it. When unchecked, follow the game's own anti-aliasing setting. If the game already enables it, this option makes no additional difference.&lt;/p&gt;&lt;p&gt;Can cause stray lines just outside some object edges.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>3D anti-aliasing</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QGroupBox" name="groupBoxTextureEnhancements">
        <property name="title">
         <string>3D texture enhancements</string>
        </property>
        <layout class="QVBoxLayout" name="verticalLayoutTextureEnhancements">
         <item>
          <widget class="QGroupBox" name="groupBoxTextureFiltering">
           <property name="title">
            <string>Texture filtering</string>
           </property>
           <layout class="QGridLayout" name="gridLayoutTextureFiltering">
         <item row="0" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayout3DTextureAnisotropy">
           <item>
            <widget class="QLabel" name="lbl3DTextureAnisotropy">
             <property name="text">
              <string>Anisotropic filtering:</string>
             </property>
             <property name="buddy">
              <cstring>cbx3DTextureAnisotropy</cstring>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="cbx3DTextureAnisotropy">
             <property name="whatsThis">
              <string>&lt;p&gt;Keep distant or angled textures clearer and reduce shimmer. Higher levels may cost performance. Some textures can develop edge artifacts, and preparing new textures may briefly cause stutter.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Off</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>2x</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>4x</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>8x</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>16x</string>
              </property>
             </item>
           </widget>
          </item>
         </layout>
        </item>
         <item row="1" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayout3DTextureFilterMipDepth">
           <item>
            <widget class="QLabel" name="lbl3DTextureFilterMipDepth">
             <property name="text">
              <string>Smallest mipmap size:</string>
             </property>
             <property name="buddy">
              <cstring>cbx3DTextureFilterMipDepth</cstring>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="cbx3DTextureFilterMipDepth">
             <property name="whatsThis">
              <string>&lt;p&gt;Choose the smallest mipmap, a reduced texture used for distant surfaces. Stopping at a larger size can reduce color bleeding between pieces of artwork and distant blur, but can increase shimmer. Down to 1x1 builds the full mipmap chain.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Down to 1x1</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>8x8 minimum</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>16x16 minimum</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>32x32 minimum</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
         <item row="2" column="0">
          <widget class="QCheckBox" name="cb3DTextureFilterBinaryAlphaHandling">
           <property name="whatsThis">
            <string>&lt;p&gt;Keep hard transparent/opaque edges when filtering cutout textures such as signs, fences, and foliage. This has low overhead, but can make outlines look less smooth.&lt;/p&gt;</string>
           </property>
           <property name="text">
           <string>Keep cutout edges opaque</string>
           </property>
         </widget>
         </item>
         <item row="2" column="1">
          <widget class="QCheckBox" name="cb3DTextureFilterMipmapAlphaHandling">
           <property name="whatsThis">
            <string>&lt;p&gt;Reduce color halos around cutout textures when filtering them at a distance. Pads colors around transparent edges before creating mipmaps, the smaller texture versions used for distant surfaces. Preparing new textures can cost extra time.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Reduce transparent-edge halos in mipmaps</string>
           </property>
         </widget>
         </item>
         <item row="2" column="2">
          <widget class="QCheckBox" name="cb3DTextureFilterMipmapTopologyHandling">
           <property name="whatsThis">
            <string>&lt;p&gt;Use simpler filtered mipmaps for fragmented texture sheets, while keeping transparent-edge padding for simple cutout textures. This can reduce colors bleeding between unrelated pieces of artwork, but some cutout edges may look worse. Requires transparent-edge halo reduction for mipmaps.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Avoid alpha-aware mipmaps on fragmented textures</string>
           </property>
         </widget>
         </item>
         <item row="3" column="0">
          <widget class="QCheckBox" name="cb3DTextureFilterMipmapSubrectHandling">
           <property name="whatsThis">
            <string>&lt;p&gt;For supported rectangular sprites, build smaller filtered textures from just the region being drawn. This can prevent neighboring artwork from bleeding into sprite edges. Other draws use the normal mipmap path. Requires transparent-edge halo reduction for mipmaps.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Isolate sprite regions for mipmaps</string>
           </property>
         </widget>
         </item>
         <item row="4" column="0">
          <widget class="QCheckBox" name="cb3DTextureFilterSmart2D">
           <property name="whatsThis">
            <string>&lt;p&gt;Keep original sampling for supported 2D artwork drawn using 3D textures. This can reduce lines and halos around sprites and stop enlarged fill pieces from becoming patchy. Other artwork remains enhanced. Included in Reduce 2D texture artifacts; disable this component if it removes smoothing you prefer.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Protect 2D artwork from filtering</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1">
          <widget class="QCheckBox" name="cb3DTextureFilterTranslucentGuard">
           <property name="whatsThis">
            <string>&lt;p&gt;Use original, unfiltered texture sampling for some large translucent effects when anisotropic filtering is enabled. This can hide seams but can make those effects look more pixelated. Included in Reduce 2D texture artifacts.&lt;/p&gt;</string>
           </property>
           <property name="text">
            <string>Use original sampling for large translucent effects</string>
           </property>
          </widget>
         </item>
         </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="groupBoxTextureScaling">
        <property name="title">
         <string>3D texture scaling</string>
        </property>
        <layout class="QVBoxLayout" name="verticalLayoutTextureScaling">
         <item>
          <widget class="QCheckBox" name="cb3DTextureScaling">
           <property name="whatsThis">
              <string>Enlarge game textures using the selected algorithm. This can improve close-up textures, but may add stutter or edge artifacts.</string>
             </property>
           <property name="text">
            <string>3D texture scaling</string>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="horizontalLayout3DTextureScalingAlgorithm">
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item>
            <widget class="QLabel" name="lbl3DTextureScalingAlgorithm">
             <property name="text">
              <string>Algorithm:</string>
             </property>
             <property name="buddy">
              <cstring>cbx3DTextureScalingAlgorithm</cstring>
             </property>
            </widget>
           </item>
           <item>
           <widget class="QComboBox" name="cbx3DTextureScalingAlgorithm">
            <property name="whatsThis">
              <string>&lt;p&gt;Chooses how to enlarge the colors in game textures. Try different algorithms to find one that suits the game.&lt;/p&gt;&lt;p&gt;Transparent edges are controlled separately by Transparency scaling in Advanced settings. Cleaner transparent edges selects xBRZ alpha.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Spline36</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>xBRZ</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>ArtCNN</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>ArtCNN DN</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>NNEDI3</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>CuNNy</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QGridLayout" name="gridLayout3DTextureScalingOptions">
           <item row="4" column="0" colspan="3">
            <widget class="QWidget" name="reconstruction3DOptions">
             <layout class="QVBoxLayout" name="reconstruction3DOptionsLayout">
              <property name="leftMargin">
               <number>0</number>
              </property>
              <property name="topMargin">
               <number>0</number>
              </property>
              <property name="rightMargin">
               <number>0</number>
              </property>
              <property name="bottomMargin">
               <number>0</number>
              </property>
              <item>
               <widget class="QCheckBox" name="cbReconstructCompatible3D">
                <property name="text">
                 <string>Upscale compatible texture pieces together</string>
                </property>
                <property name="whatsThis">
                 <string>&lt;p&gt;Treat compatible adjacent pieces drawn using 3D textures as shared artwork when upscaling. This can reduce seams between pieces. Pieces with incompatible placement, textures, depth, or effects remain separate. Uses the selected texture color and transparency scaling and can add processing and memory costs.&lt;/p&gt;</string>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QVBoxLayout" name="reconstruction3DChildrenLayout">
                <property name="leftMargin">
                 <number>20</number>
                </property>
                <item>
                 <widget class="QCheckBox" name="cbReconstructCompatible3DEdgeContext">
                  <property name="text">
                   <string>Use neighboring artwork at joined edges</string>
                  </property>
                  <property name="whatsThis">
                   <string>&lt;p&gt;Use neighboring artwork to improve continuity at joined texture edges when there is one clear matching neighbor. Ambiguous overlaps remain unchanged. Requires compatible texture-piece upscaling and adds reconstruction work.&lt;/p&gt;</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QCheckBox" name="cbReconstructCompatible3DFractionalAlpha">
                  <property name="text">
                   <string>Include semi-transparent pieces</string>
                  </property>
                  <property name="whatsThis">
                   <string>&lt;p&gt;Also join compatible pieces containing partly transparent artwork, such as split characters. Keeps their partial transparency and original drawing order. Requires compatible texture-piece upscaling and adds processing and memory costs.&lt;/p&gt;</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item row="0" column="0">
            <widget class="QCheckBox" name="cb3DTextureScalingLegacyAlphaHandling">
             <property name="whatsThis">
              <string>&lt;p&gt;Skip color padding around transparent texture edges before upscaling. Use this to compare how padding affects edge colors; disabling padding can restore halos or stray colors. Overrides More thorough transparent-edge padding. This is separate from the transparency-scaling algorithm and is not limited to Classic OpenGL.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Disable transparent-edge color padding</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QCheckBox" name="cb3DTextureScalingQualityAlphaHandling">
             <property name="whatsThis">
              <string>&lt;p&gt;Use more thorough color padding around fully transparent areas of cutout textures before upscaling. This can reduce edge artifacts, but may cause more stutter when new textures appear. When off, a faster limited padding pass is used. Has no effect while transparent-edge color padding is disabled.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>More thorough transparent-edge padding</string>
             </property>
            </widget>
           </item>
           <item row="0" column="2">
            <widget class="QCheckBox" name="cb3DTextureScalingAlphaXBRZ">
             <property name="whatsThis">
              <string>&lt;p&gt;Try this if cutout edges look blocky or uneven after texture upscaling. Selects xBRZ in the advanced Transparency scaling menu while keeping the selected color algorithm. Turning it off selects Bilinear transparency scaling.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Cleaner transparent edges</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QCheckBox" name="cb3DTextureScalingFrequentChangePolicy">
             <property name="whatsThis">
              <string>&lt;p&gt;Use simpler scaling for rapidly changing textures and reuse matching enhanced images when possible. This can reduce stutter during animations and effects, but those textures may look more pixelated. The game's texture updates are not delayed.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Limit upscaling of changing textures</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QCheckBox" name="cb3DTextureScalingDeferred">
             <property name="whatsThis">
              <string>&lt;p&gt;Show eligible new textures at their original detail first, then upscale them after they have been reused and remained stable. This can reduce pauses when textures change, but you may notice them become sharper a moment later. Applies to supported palette-based textures; it does not delay every texture or the game's updates.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Defer texture upscaling</string>
             </property>
            </widget>
           </item>
           <item row="1" column="2">
            <widget class="QCheckBox" name="cb3DTextureScalingNativeMipFloor">
             <property name="whatsThis">
              <string>&lt;p&gt;Stop generating smaller filtered versions once a scaled texture reaches its original size. This can retain distant detail but may increase shimmer. Power-of-two scales can end at the original size; other scales stop at the last mipmap still above it.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Stop mipmaps at original texture size</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QCheckBox" name="cb3DTextureScalingSourceMips">
             <property name="whatsThis">
              <string>&lt;p&gt;Build smaller filtered texture versions by upscaling the original artwork again instead of shrinking the largest enhanced version. This can improve consistency of color and detail, but adds work when new textures appear. Applies to power-of-two texture scales.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Build mipmaps from original artwork</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QCheckBox" name="cb3DTextureScalingEdgeExtendUnusedMargins">
             <property name="whatsThis">
              <string>&lt;p&gt;Extend edge colors into unused areas of supported clamped textures before upscaling. This can stop unrelated or unused pixels from creating lines around the artwork, but adds processing and cannot remove every seam. Included in Reduce 2D texture artifacts.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Pad unused texture edges before upscaling</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         </layout>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="horizontalLayout3DTextureCoordinateEnhancements">
          <item>
           <widget class="QCheckBox" name="cb3DHighPrecisionTextureCoordinates">
            <property name="whatsThis">
             <string>&lt;p&gt;Keep texture details better aligned with high-resolution 3D by using more precise texture coordinates. Compute only, above native resolution; texture upscaling does not need to be enabled. This affects texture placement, not polygon-edge snapping.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>High-precision texture coordinates</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="cb3DTextureFilterSpriteUVInset">
            <property name="whatsThis">
             <string>&lt;p&gt;Sample slightly inside the texture edges of supported rectangular sprites to reduce lines or stray colors from neighboring artwork. This can trim edge pixels. Included in Reduce 2D texture artifacts; disable it if sprite edges appear cropped.&lt;/p&gt;</string>
            </property>
            <property name="text">
             <string>Inset sprite texture edges</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="horizontalSpacer3DTextureCoordinateEnhancements">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>0</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QCheckBox" name="cb3DTexture2DAtlasProtection">
          <property name="whatsThis">
           <string>&lt;p&gt;Try this if sprites, menus, or backgrounds develop lines, halos, or stray pixels after texture filtering or upscaling. Combines several fixes for 2D artwork drawn using 3D textures, including joining compatible pieces before upscaling to reduce seams. May cost performance or change texture edges, and will not fix every game. Advanced settings exposes the individual fixes. A partially checked box means only some are enabled.&lt;/p&gt;</string>
          </property>
          <property name="text">
           <string>Reduce 2D texture artifacts</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
      <item row="9" column="0">
       <widget class="QGroupBox" name="groupBoxWholeScene2DScaling">
        <property name="title">
         <string>Whole-scene 2D scaling</string>
        </property>
        <layout class="QGridLayout" name="gridLayoutWholeScene2DScaling">
         <item row="0" column="0" colspan="3">
          <widget class="QCheckBox" name="cbWholeScene2DScale">
           <property name="whatsThis">
            <string>&lt;p&gt;Improve text, sprites, backgrounds, and menus using the selected method and upscaling algorithm. Complex effects may remain at their original detail, and more demanding algorithms can reduce performance.&lt;/p&gt;</string>
           </property>
           <property name="text">
           <string>Enable screen upscaling</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayoutWholeScene2DScaleMode">
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item>
            <widget class="QLabel" name="lblWholeScene2DScaleMode">
             <property name="text">
              <string>Mode:</string>
             </property>
             <property name="buddy">
              <cstring>cbxWholeScene2DScaleMode</cstring>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="cbxWholeScene2DScaleMode">
             <property name="whatsThis">
              <string>&lt;p&gt;Choose how 2D artwork and 3D graphics are combined and upscaled. Hybrid preserves sharp 3D where possible. Postprocessing upscales the completed screen and can help when Hybrid has visual problems, but 3D usually looks softer.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Hybrid Upscale</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Postprocessing Upscale</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Presentation Overlay Upscale</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>High-resolution Compositor</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Native Stack Upscale</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
         <item row="2" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayoutWholeScene2DScaleAlgorithm">
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item>
            <widget class="QLabel" name="lblWholeScene2DScaleAlgorithm">
             <property name="text">
              <string>Algorithm:</string>
             </property>
             <property name="buddy">
              <cstring>cbxWholeScene2DScaleAlgorithm</cstring>
             </property>
            </widget>
           </item>
           <item>
           <widget class="QComboBox" name="cbxWholeScene2DScaleAlgorithm">
            <property name="whatsThis">
               <string>&lt;p&gt;Choose how to enlarge the colors in the screen image and supported sprite and background artwork. Try different algorithms to find one that suits the game. With Improve rotation and scaling enabled, sprite and background transparency follows Automatic or the Transparency reconstruction override in Advanced settings.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Spline36</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>xBRZ</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>ArtCNN</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>ArtCNN DN</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>NNEDI3</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>CuNNy</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
         <item row="3" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayoutWholeScene2DScaleFinalUpscale3DFilter">
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item>
            <widget class="QLabel" name="lblWholeScene2DScaleFinalUpscale3DFilter">
             <property name="text">
              <string>3D downsample filter:</string>
             </property>
             <property name="buddy">
              <cstring>cbxWholeScene2DScaleFinalUpscale3DFilter</cstring>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="cbxWholeScene2DScaleFinalUpscale3DFilter">
             <property name="whatsThis">
              <string>&lt;p&gt;Choose how high-resolution 3D is reduced to the original screen resolution before screen upscaling. Applies to Postprocessing, Presentation Overlay, and Hybrid when 3D is rendered above native resolution. Area / Box averages the source pixels and is recommended. Linear uses linear sampling. Tent uses a softer weighted average that may smooth edges but blur details.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Area / Box</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Linear</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Tent</string>
              </property>
             </item>
           </widget>
          </item>
         </layout>
        </item>
         <item row="4" column="0" colspan="3">
          <layout class="QHBoxLayout" name="horizontalLayoutWholeScene2DScaleFragmentationFallback">
           <property name="leftMargin">
            <number>20</number>
           </property>
           <item>
            <widget class="QLabel" name="lblWholeScene2DScaleFragmentationFallback">
             <property name="text">
              <string>Fragmented-frame fallback:</string>
             </property>
             <property name="buddy">
              <cstring>cbxWholeScene2DScaleFragmentationFallback</cstring>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="cbxWholeScene2DScaleFragmentationFallback">
             <property name="whatsThis">
              <string>&lt;p&gt;Choose how to reduce slowdown when mid-frame display changes make screen upscaling expensive. Skip upscaling for video-like frames uses the original rendering for heavily split bitmap, captured-image, or sprite-only screens. Use Postprocessing keeps upscaling but switches complex Hybrid frames to Postprocessing. Skip upscaling for very complex frames can also bypass upscaling when Postprocessing would still be too slow. Off keeps the selected method. These fallbacks can change image quality during affected frames.&lt;/p&gt;</string>
             </property>
             <item>
              <property name="text">
               <string>Skip upscaling for video-like frames</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Use Postprocessing</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Skip upscaling for very complex frames</string>
              </property>
             </item>
             <item>
              <property name="text">
               <string>Off</string>
              </property>
             </item>
            </widget>
           </item>
          </layout>
         </item>
         <item row="5" column="0" colspan="3">
          <layout class="QGridLayout" name="gridLayoutWholeScene2DScaleOptions">
           <property name="leftMargin">
            <number>0</number>
           </property>
           <item row="0" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleExactFinalFallback">
             <property name="whatsThis">
              <string>&lt;p&gt;Experimental comparison option for Native Stack Upscale. Also upscale the completed original-resolution screen and use it where the game blends layers. This can reduce fade or dialogue artifacts, but may introduce seams in other scenes.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Use completed-screen fallback for blending</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleForegroundOverlay">
             <property name="whatsThis">
              <string>&lt;p&gt;Experimental comparison option for Native Stack Upscale. Upscale the completed 2D foreground over live 3D in supported scenes. Not used with captured-image layers or other unsupported effects.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Upscale the completed 2D foreground</string>
             </property>
            </widget>
           </item>
           <item row="0" column="2">
            <widget class="QCheckBox" name="cbWholeScene2DScaleCaptureBacked">
             <property name="whatsThis">
              <string>&lt;p&gt;Allow supported images that the game copies internally from the DS display to use enhanced rendering. Helps some menus, overlays, and games that reuse 3D images between screens. Unsupported copies keep their original rendering. This controls in-game display copies, not screenshots or video recording.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Enhance captured screen images</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleSourceBoundaryGuard">
             <property name="whatsThis">
              <string>&lt;p&gt;Reduce colors bleeding between separate 2D layers by using more of the original pixels near their boundaries. This can make text and thin interface details look less smooth. Applies to Native Stack Upscale.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Protect source boundaries</string>
             </property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleDebugTint">
             <property name="whatsThis">
              <string>&lt;p&gt;Replace normal colors with diagnostic colors identifying the layers and rendering paths used for the image. Use this to inspect how a scene is composed, not to improve image quality.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Color-code rendering layers (debug)</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleNoWrapFilterTaps">
             <property name="whatsThis">
              <string>&lt;p&gt;Prevent Spline36 from blending pixels across the edges of repeating background textures. This can reduce edge artifacts, but may remove smoothing where the texture repeats. Applies to High-resolution Compositor.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Prevent filtering across repeating background edges</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleFinalUpscaleRender3DNative">
             <property name="whatsThis">
              <string>&lt;p&gt;Render 3D at its original resolution. In Postprocessing, this can fix mismatched 2D and 3D edges at the cost of 3D detail. The completed screen is still upscaled. In Hybrid and Presentation Overlay, live 3D areas instead retain unfiltered original-resolution pixels, so this is mainly useful for comparison there.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Render 3D at native resolution</string>
             </property>
            </widget>
           </item>
           <item row="2" column="2">
            <widget class="QCheckBox" name="cbWholeScene2DScaleFinalUpscale3DCoverageAware">
             <property name="whatsThis">
              <string>&lt;p&gt;When reducing high-resolution 3D for screen upscaling, average colors from samples covered by polygons instead of mixing in the clear background color. This can reduce colored outlines around 3D edges. Applies to Postprocessing, Presentation Overlay, and Hybrid.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Reduce color fringes when downsampling 3D</string>
             </property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleOverlayLegacyUnderlay">
             <property name="whatsThis">
              <string>&lt;p&gt;Use the raw 3D image and its transparency beneath overlays instead of matching the game's completed layer blending. This can change edge blending but may introduce seams around overlays. Applies to Hybrid and Presentation Overlay.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Use raw 3D beneath overlays (comparison)</string>
             </property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleFinalUpscale3DRepresentativeSemantics">
             <property name="whatsThis">
              <string>&lt;p&gt;Use a representative original-resolution 3D sample to decide layer presence and transparency when combining 3D with 2D. Turn off to use the transparency from the downsampled visual image instead. A comparison option for Postprocessing, Presentation Overlay, and Hybrid.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Use original-resolution 3D blending data</string>
             </property>
            </widget>
           </item>
           <item row="3" column="2">
            <widget class="QCheckBox" name="cbWholeScene2DScaleFinalUpscale3DSplitSemantics">
             <property name="whatsThis">
              <string>&lt;p&gt;Keep partial coverage at high-resolution polygon edges separate from the transparency of the polygon itself when combining 3D with 2D. Turn off to compare using one alpha value for both.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Separate 3D edge coverage from transparency</string>
             </property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleFinalUpscale3DSharpenSplitCoverage">
             <property name="whatsThis">
              <string>&lt;p&gt;Make reconstructed 3D edge coverage more sharply defined. This can reduce blending with the background but may make edges more jagged. Requires Separate 3D edge coverage from transparency.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Sharpen reconstructed 3D edges</string>
             </property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridWindowEdgeAssist">
             <property name="whatsThis">
              <string>&lt;p&gt;In Hybrid mode, smooth supported corners and edges around areas hidden by the game using screen masks. This can also soften nearby 3D edges.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Smooth edges around screen masks</string>
             </property>
            </widget>
           </item>
           <item row="4" column="2">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridTarget2AlphaBlendAssist">
             <property name="whatsThis">
              <string>&lt;p&gt;In Hybrid mode, keep high-resolution 3D beneath supported translucent 2D overlays. May change the appearance of games with more complex layer blending.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Preserve sharp 3D beneath translucent overlays</string>
             </property>
            </widget>
           </item>
           <item row="5" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridForeground2DBase">
             <property name="whatsThis">
              <string>&lt;p&gt;In Hybrid mode, use an enhanced 2D background in supported narrow areas beside foreground 3D. This can reduce low-resolution fringes but may change nearby 2D/3D boundaries. Complex effects, overlays, and ambiguous screen masks are excluded.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Reduce low-resolution fringes around foreground 3D</string>
             </property>
            </widget>
           </item>
           <item row="5" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridNativeEffectGuard">
             <property name="whatsThis">
              <string>&lt;p&gt;In Hybrid mode, keep the original rendering near some 2D brightness and blending effects to avoid splitting their appearance across layers. Nearby 3D may look less sharp.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Preserve original rendering around 2D effects</string>
             </property>
            </widget>
           </item>
           <item row="5" column="2">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridCleanLegacyCandidate">
             <property name="whatsThis">
              <string>&lt;p&gt;In Hybrid mode, use Native Stack Upscale to combine simple 3D and 2D scenes without capture, screen masks, or alpha blending. This can avoid overlay artifacts without an extra rendering pass. Other scenes keep their normal Hybrid path.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Use simpler composition for basic scenes</string>
             </property>
            </widget>
           </item>
           <item row="6" column="0">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineHighRes">
             <property name="whatsThis">
              <string>&lt;p&gt;Make supported sprites and backgrounds smoother when rotated or resized in Hybrid mode. This also upscales their artwork using the selected upscaling algorithm. Advanced settings lets you disable artwork upscaling separately.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Improve rotation and scaling</string>
             </property>
            </widget>
           </item>
           <item row="6" column="1">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineSourceEnhancement">
             <property name="whatsThis">
              <string>&lt;p&gt;Upscale supported sprite and background artwork with the selected upscaling algorithm before rotating or resizing it. Turn this off to keep the original artwork while retaining smoother rotation and scaling. Transparency reconstruction is selected separately.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Upscale sprite and background artwork</string>
             </property>
            </widget>
           </item>
            <item row="12" column="0" colspan="3">
            <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineTopTextBG">
             <property name="whatsThis">
              <string>&lt;p&gt;Also upscale supported ordinary tile backgrounds in scenes with improved rotation and scaling. These layers can contain scenery, menus, or text; this does not specifically detect written text. Requires sprite and background artwork upscaling. Supported edges use the selected transparency reconstruction.&lt;/p&gt;</string>
             </property>
             <property name="text">
              <string>Upscale additional tile backgrounds</string>
             </property>
           </widget>
           </item>
            <item row="16" column="0" colspan="3">
             <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineConnectedSources">
              <property name="text"><string>Join adjacent sprite pieces</string></property>
              <property name="whatsThis"><string>&lt;p&gt;Upscale compatible adjoining sprite pieces together to reduce seams. Some layouts and effects cannot be combined, and animation can change which pieces qualify. Works with either sampling mode and any transparency-reconstruction algorithm.&lt;/p&gt;</string></property>
             </widget>
            </item>
            <item row="18" column="0" colspan="3">
             <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineOpaqueAssemblies">
              <property name="text"><string>Combine overlapping sprite pieces</string></property>
              <property name="whatsThis"><string>&lt;p&gt;Upscale compatible overlapping sprite pieces together to reduce seams. Pieces are combined only when drawing order and effects can be preserved; shadows and other separate blend effects retain their original behavior. Works with either sampling mode and any transparency-reconstruction algorithm. Adds processing and memory costs.&lt;/p&gt;</string></property>
             </widget>
            </item>
            <item row="15" column="0" colspan="3">
             <widget class="QCheckBox" name="cbWholeScene2DScaleHybridStrictAffineMaskedOBJMLAA">
              <property name="whatsThis">
               <string>&lt;p&gt;Smooth small staircase edges that remain after sprites and backgrounds are combined. Most noticeable on ordinary sprite and interface outlines that still follow the original pixel mask. Already reconstructed outlines usually keep their own smoothing. Adds rendering work and may make little visible difference. Does not repair incorrect transparency or blending.&lt;/p&gt;</string>
              </property>
              <property name="text">
               <string>Smooth remaining sprite and background edges</string>
              </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacerOpenGLRendererScroll">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="title">
      <string>Software renderer</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_3">
      <item row="0" column="0">
       <widget class="QCheckBox" name="cbSoftwareThreaded">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Run the software renderer on a separate thread. Yields better performance on multi-core CPUs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Use separate thread</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="4" column="0" colspan="2">
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Orientation::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
   <item row="0" column="0" rowspan="3" alignment="Qt::AlignmentFlag::AlignTop">
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>Display settings</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="7" column="1">
       <widget class="QSpinBox" name="sbVSyncInterval">
        <property name="whatsThis">
         <string>&lt;p&gt;Choose how many monitor refreshes to wait between presented frames. For roughly 60 frames per second, use 1 on a 60 Hz monitor or 2 on a 120 Hz monitor. Other refresh rates may not divide evenly. Requires VSync.&lt;/p&gt;</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>20</number>
        </property>
       </widget>
      </item>
      <item row="5" column="0" colspan="2">
       <widget class="QCheckBox" name="cbGLDisplay">
        <property name="whatsThis">
         <string>&lt;p&gt;Use OpenGL to display the DS screens in the window. This can improve frame pacing and is required by the OpenGL 3D renderers.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>OpenGL display</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <spacer name="verticalSpacer">
        <property name="orientation">
         <enum>Qt::Orientation::Vertical</enum>
        </property>
        <property name="sizeType">
         <enum>QSizePolicy::Policy::Fixed</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size>
          <width>20</width>
          <height>20</height>
         </size>
        </property>
       </spacer>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QCheckBox" name="cbVSync">
        <property name="whatsThis">
         <string>&lt;p&gt;Synchronize video output to the monitor's refresh cycle to reduce screen tearing. Requires OpenGL display.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>VSync</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="label_2">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="whatsThis">
         <string>&lt;p&gt;Choose how many monitor refreshes to wait between presented frames. For roughly 60 frames per second, use 1 on a 60 Hz monitor or 2 on a 120 Hz monitor. Other refresh rates may not divide evenly. Requires VSync.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>VSync interval:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QRadioButton" name="rb3DOpenGL">
        <property name="whatsThis">
         <string>&lt;p&gt;Use the Classic OpenGL renderer for GPU-rendered 3D and graphical enhancements. Try it if Compute is unavailable or a game has rendering problems; some effects may look different.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>OpenGL (Classic)</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="2">
       <widget class="QRadioButton" name="rb3DSoftware">
        <property name="whatsThis">
         <string>&lt;p&gt;Render original-resolution 3D on the CPU. Useful for checking whether a visual problem comes from an enhanced 3D renderer. OpenGL display and screen enhancements are separate settings. CPU usage may be higher.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>Software</string>
        </property>
       </widget>
      </item>
      <item row="0" column="0" colspan="2">
       <widget class="QLabel" name="label">
        <property name="text">
         <string>Renderer:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QRadioButton" name="rb3DCompute">
        <property name="whatsThis">
         <string>&lt;p&gt;Suggested starting point where supported. Uses the GPU for 3D rendering and supports graphical enhancements. Requires OpenGL 4.3 and is unavailable on macOS. Try Classic if a game has rendering problems.&lt;/p&gt;</string>
        </property>
        <property name="text">
         <string>OpenGL (Compute shader)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <tabstops>
  <tabstop>rb3DSoftware</tabstop>
  <tabstop>rb3DOpenGL</tabstop>
  <tabstop>cbGLDisplay</tabstop>
  <tabstop>cbVSync</tabstop>
  <tabstop>sbVSyncInterval</tabstop>
  <tabstop>cbSoftwareThreaded</tabstop>
  <tabstop>cbxGLResolution</tabstop>
  <tabstop>cbBetterPolygons</tabstop>
  <tabstop>cbReadable3DTextureCache</tabstop>
  <tabstop>cbx3DTextureAnisotropy</tabstop>
  <tabstop>cbx3DTextureFilterMipDepth</tabstop>
  <tabstop>cb3DTextureFilterBinaryAlphaHandling</tabstop>
